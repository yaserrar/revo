generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
  REFUNDED
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  sessions  Session[]
  orders    Order[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String      @default("")
  priceCents  Int
  stock       Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  items       OrderItem[]
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int
  expiresAt  DateTime?
  orders     Order[]
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  subtotalCents Int
  discountCents Int         @default(0)
  taxCents      Int
  totalCents    Int
  couponId      String?
  coupon        Coupon?     @relation(fields: [couponId], references: [id])
  paymentId     String?     @unique
  createdAt     DateTime    @default(now())
  paidAt        DateTime?
  items         OrderItem[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
}
