+import { requireAdmin } from '@/lib/auth';
+import { addDays, isoDay } from '@/lib/dates';
+import { db } from '@/lib/db';
+import { handle, json } from '@/lib/http';
+
+/** Paid revenue per day for the 7 days before today, for the admin dashboard chart. */
+export const GET = handle(async (req) => {
+  await requireAdmin(req);
+  const today = new Date();
+  today.setHours(0, 0, 0, 0);
+  const from = addDays(today, -7);
+
+  const orders = await db.order.findMany({
+    where: { createdAt: { gte: from, lt: today }, status: { in: ['PAID', 'SHIPPED'] } },
+    select: { createdAt: true, totalCents: true },
+  });
+
+  const revenueByDay = new Map<string, number>();
+  for (let i = 0; i < 7; i++) revenueByDay.set(isoDay(addDays(from, i)), 0);
+  for (const order of orders) {
+    const day = isoDay(order.createdAt);
+    revenueByDay.set(day, (revenueByDay.get(day) ?? 0) + order.totalCents);
+  }
+  return json({ days: [...revenueByDay].map(([day, revenueCents]) => ({ day, revenueCents })) });
+});
