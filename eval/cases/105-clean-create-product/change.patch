@@ -0,0 +1,23 @@
+import { describe, expect, it } from 'vitest';
+import { CreateProductSchema } from '../src/lib/validation';
+
+const valid = { slug: 'Cast-Iron-Pan', name: 'Cast iron pan', priceCents: 4900 };
+
+describe('CreateProductSchema', () => {
+  it('normalises the slug and fills defaults', () => {
+    expect(CreateProductSchema.parse(valid)).toEqual({
+      slug: 'cast-iron-pan',
+      name: 'Cast iron pan',
+      description: '',
+      priceCents: 4900,
+      stock: 0,
+    });
+  });
+
+  it('rejects bad slugs and prices', () => {
+    expect(CreateProductSchema.safeParse({ ...valid, slug: 'pan--large' }).success).toBe(false);
+    expect(CreateProductSchema.safeParse({ ...valid, slug: 'pan large' }).success).toBe(false);
+    expect(CreateProductSchema.safeParse({ ...valid, priceCents: 0 }).success).toBe(false);
+    expect(CreateProductSchema.safeParse({ ...valid, priceCents: 12.5 }).success).toBe(false);
+  });
+});
