+
+/** Admin: adds a product to the catalogue. Slugs are unique. */
+export const POST = handle(async (req) => {
+  await requireAdmin(req);
+  const input = CreateProductSchema.parse(await req.json());
+  try {
+    const product = await db.product.create({ data: input });
+    return json({ product }, { status: 201 });
+  } catch (err) {
+    if (err instanceof Prisma.PrismaClientKnownRequestError && err.code === 'P2002') {
+      throw new HttpError(409, `A product with the slug "${input.slug}" already exists`);
+    }
+    throw err;
+  }
+});
