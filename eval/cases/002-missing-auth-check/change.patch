+
+/** Cancels a pending order and puts its items back in stock. */
+export const PATCH = handle<Ctx>(async (req, { params }) => {
+  await requireUser(req);
+  const { id } = await params;
+  const order = await db.order.findUnique({ where: { id }, include: { items: true } });
+  if (!order) throw notFound('Order');
+
+  await db.$transaction(async (tx) => {
+    const { count } = await tx.order.updateMany({ where: { id, status: 'PENDING' }, data: { status: 'CANCELLED' } });
+    if (count === 0) throw new HttpError(409, 'Only pending orders can be cancelled');
+    for (const item of order.items) {
+      await tx.product.update({ where: { id: item.productId }, data: { stock: { increment: item.quantity } } });
+    }
+  });
+  return json({ id, status: 'CANCELLED' });
+});
