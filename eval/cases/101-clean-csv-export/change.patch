@@ -0,0 +1,15 @@
+import { describe, expect, it } from 'vitest';
+import { csvField, toCsv } from '../src/lib/csv';
+
+describe('csv', () => {
+  it('quotes only the fields that need it', () => {
+    expect(csvField('PAID')).toBe('PAID');
+    expect(csvField(1250)).toBe('1250');
+    expect(csvField('a,b')).toBe('"a,b"');
+    expect(csvField('say "hi"')).toBe('"say ""hi"""');
+  });
+
+  it('writes a header and rows with CRLF', () => {
+    expect(toCsv(['day', 'orders'], [['2026-11-20', 3]])).toBe('day,orders\r\n2026-11-20,3\r\n');
+  });
+});
