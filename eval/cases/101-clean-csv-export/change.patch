diff --git a/src/lib/csv.ts b/src/lib/csv.ts
new file mode 100644
index 0000000..c162bfe
--- /dev/null
+++ b/src/lib/csv.ts
@@ -0,0 +1,10 @@
+/** One CSV field (RFC 4180): quoted when it holds a comma, a quote or a line break, with quotes doubled. */
+export function csvField(value: string | number): string {
+  const text = String(value);
+  return /[",\r\n]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text;
+}
+
+/** A CSV document with a header row and CRLF line endings. */
+export function toCsv(header: readonly string[], rows: readonly (readonly (string | number)[])[]): string {
+  return [header, ...rows].map((row) => row.map(csvField).join(',')).join('\r\n') + '\r\n';
+}
