+import { requireAdmin } from '@/lib/auth';
+import { db } from '@/lib/db';
+import { handle, HttpError, json, notFound } from '@/lib/http';
+import { refundPayment } from '@/lib/payments';
+
+type Ctx = { params: Promise<{ id: string }> };
+
+/** Support refunds a paid order in full. */
+export const POST = handle<Ctx>(async (req, { params }) => {
+  await requireAdmin(req);
+  const { id } = await params;
+  const order = await db.order.findUnique({ where: { id } });
+  if (!order) throw notFound('Order');
+  if (order.status !== 'PAID' || !order.paymentId) throw new HttpError(409, 'Only paid orders can be refunded');
+
+  const refund = await refundPayment(order.paymentId, order.totalCents);
+  const updated = await db.order.update({ where: { id }, data: { status: 'REFUNDED' } });
+  return json({ order: updated, refundId: refund.id });
+});
