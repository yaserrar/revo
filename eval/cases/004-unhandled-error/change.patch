+export type Refund = { id: string; status: 'succeeded' | 'pending' | 'failed' };
+
+/** Refunds a payment in full or in part. */
+export async function refundPayment(paymentId: string, amountCents: number): Promise<Refund> {
+  const res = await fetch(`${env.PAYMENTS_API_URL}/v1/refunds`, {
+    method: 'POST',
+    headers: { authorization: `Bearer ${env.PAYMENTS_API_KEY}`, 'content-type': 'application/json' },
+    body: JSON.stringify({ paymentId, amountCents }),
+  });
+  return (await res.json()) as Refund;
+}
