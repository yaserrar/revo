diff --git a/tests/money.test.ts b/tests/money.test.ts
new file mode 100644
index 0000000..e5660b6
--- /dev/null
+++ b/tests/money.test.ts
@@ -0,0 +1,16 @@
+import { describe, expect, it } from 'vitest';
+import { formatCents, percentOf, taxOn } from '../src/lib/money';
+
+describe('money', () => {
+  it('formats cents as dollars with separators', () => {
+    expect(formatCents(0)).toBe('$0.00');
+    expect(formatCents(5)).toBe('$0.05');
+    expect(formatCents(123450)).toBe('$1,234.50');
+    expect(formatCents(-500)).toBe('-$5.00');
+  });
+
+  it('rounds tax half up and discounts down', () => {
+    expect(taxOn(1800)).toBe(149);
+    expect(percentOf(999, 10)).toBe(99);
+  });
+});
