# Revo production settings for deploy/ec2/docker-compose.yml.
# On the server: ~/revo/.env (mode 600). Never commit the filled-in file.

# ── Compose ──────────────────────────────────────────────────────────────────
# DNS A record pointing at the server (behind Cloudflare: proxied, SSL Full (strict)).
DOMAIN=revo.example.com
# Images: ghcr.io/<IMAGE_OWNER>/revo-{web,worker,migrate}:<IMAGE_TAG> (GitHub owner, lowercase).
IMAGE_OWNER=your-github-user
# The deploy workflow sets this to the commit SHA on every deploy.
IMAGE_TAG=latest

# ── Core ─────────────────────────────────────────────────────────────────────
APP_URL=https://revo.example.com
# The infra Postgres (container "postgres"). Create the role and database once:
#   docker exec -it postgres psql -U postgres \
#     -c "CREATE ROLE revo LOGIN PASSWORD '<REVO_DB_PASSWORD>';" \
#     -c "CREATE DATABASE revo OWNER revo;" -c "REVOKE CONNECT ON DATABASE revo FROM PUBLIC;"
# openssl rand -hex 24 (hex: safe inside the URL)
REVO_DB_PASSWORD=
DATABASE_URL=postgresql://revo:<REVO_DB_PASSWORD>@postgres:5432/revo
REDIS_URL=redis://redis:6379/0

# ── GitHub App (pnpm github:app --url https://revo.example.com) ──────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# PEM key on one line with \n escapes, inside double quotes.
GITHUB_APP_PRIVATE_KEY=

# ── Secrets: openssl rand -base64 32 each ────────────────────────────────────
AUTH_SECRET=
# Encrypts GitHub tokens and the accounts' Anthropic keys. Web and worker both read
# it from this file: never change it once keys are saved (they could not be read).
TOKEN_ENCRYPTION_KEY=

# ── Claude (set a monthly spend limit on this key in console.anthropic.com) ──
ANTHROPIC_API_KEY=
REVO_ENGINE=claude

# ── AI access per account ────────────────────────────────────────────────────
# Free tier on ANTHROPIC_API_KEY: reviews per account per UTC month, and Revo's
# total free-tier spend per month (USD). Accounts with their own key: no limits.
FREE_REVIEWS_PER_MONTH=20
FREE_MONTHLY_CAP_USD=50
# Your own GitHub login(s), comma-separated: Revo's key with no free-tier limits.
REVO_OWNER_ACCOUNTS=
# Leave empty on a shared server (the local Claude subscription is for self-hosting).
REVO_ALLOW_CLAUDE_SUBSCRIPTION=
# Shown on /privacy and /terms (empty = GitHub issues of the source repo).
CONTACT_EMAIL=

# ── Operations ───────────────────────────────────────────────────────────────
REVIEW_DEBOUNCE_SECONDS=90
LOG_LEVEL=info
WORKER_CONCURRENCY=2
