+    expect(
+      readCookies(
+        'a=1; dropwave_unlock=x.y; b=2; dropwave_unlock=z',
+        'dropwave_unlock',
+      ),
+    ).toEqual(['x.y', 'z']);
+  });
+
+  it('decodes values and ignores other or malformed cookies', () => {
