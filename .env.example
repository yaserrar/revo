# Revo environment. Copy to .env (gitignored) and fill in.
# One file at the repo root serves every app and package: Next loads it through
# dotenv-cli, the worker and scripts through --env-file, Docker Compose through
# env_file. Secrets live only here (or in the server's environment), never in git.
# Never set NODE_ENV here: it breaks `next build`.
#
# Local development: the values below work with the Homebrew Postgres (5433),
# Redis db 7 and the mock GitHub (pnpm mock:github). Production (Docker Compose
# on EC2): see DEPLOY.md; Compose sets DATABASE_URL, REDIS_URL and APP_URL itself.

# ── Core (spec 16) ───────────────────────────────────────────────────────────
# Postgres. Compose overrides it with the postgres service.
DATABASE_URL=postgresql://user@localhost:5433/revo_dev
# Redis for BullMQ. Must use maxmemory-policy noeviction. Compose overrides it.
REDIS_URL=redis://localhost:6379/7
# Public URL of the dashboard: links in PR comments and checks, OAuth callback base.
# Compose sets it to https://$DOMAIN.
APP_URL=http://localhost:3830

# GitHub App (create it with `pnpm github:app --url https://<your domain>`, see DEPLOY.md).
GITHUB_APP_ID=
# PEM private key. Real newlines, or one line with \n escapes inside double quotes.
GITHUB_APP_PRIVATE_KEY=
# Secret GitHub signs webhooks with (X-Hub-Signature-256). Deliveries without it are rejected.
GITHUB_WEBHOOK_SECRET=
# The GitHub App's OAuth client id and secret (dashboard sign-in through Auth.js).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public slug of the app (github.com/apps/<slug>), for the "Install on GitHub" links.
GITHUB_APP_SLUG=

# Auth.js session encryption, 32+ random characters: openssl rand -base64 32
AUTH_SECRET=
# Key for the GitHub user tokens stored in the database (AES-256-GCM). Optional:
# defaults to a key derived from AUTH_SECRET. openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Claude API key (worker only). Never log it, never commit it.
ANTHROPIC_API_KEY=
# Review engine: claude (needs ANTHROPIC_API_KEY) or fake (deterministic, offline,
# for local work and tests). Empty = claude when a key is set, else fake.
# Production: docker-compose.yml sets claude; the worker refuses fake in production
# (unless REVO_TEST_MODE=1, for tests against the mock GitHub).
REVO_ENGINE=

# Seconds to wait after a push before reviewing (a newer push replaces the waiting job).
REVIEW_DEBOUNCE_SECONDS=90

# ── Analytics (optional) ─────────────────────────────────────────────────────
# PostHog project token (public, write-only). Inlined at build time: in production
# the deploy workflow passes the repo's Actions variable NEXT_PUBLIC_POSTHOG_KEY.
# Empty = no analytics (local dev and self-hosting send nothing).
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to the US region: https://us.i.posthog.com and https://us.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_UI_HOST=

# ── Operations ───────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Reviews the worker runs at the same time (1-16).
WORKER_CONCURRENCY=2
# BullMQ key prefix (default revo). Tests use throwaway prefixes.
REVO_QUEUE_PREFIX=

# ── Docker Compose on EC2 (DEPLOY.md) ────────────────────────────────────────
# Domain pointing at the server (an A record); Traefik gets its certificate.
DOMAIN=revo.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=
# Password of the revo Postgres role inside Compose: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Local tests only (ignored in production builds) ──────────────────────────
# Integration tests (pnpm db:test:prepare first).
TEST_DATABASE_URL=postgresql://user@localhost:5433/revo_test
# Point sign-in and the GitHub API at the mock GitHub (pnpm mock:github, port 4830).
# Honoured outside production; in a production build only with REVO_TEST_MODE=1 and a localhost URL.
GITHUB_OAUTH_BASE_URL=
GITHUB_API_URL=
REVO_TEST_MODE=
# With the mock: GITHUB_APP_ID=1 (the mock's app id) and any RSA private key, e.g.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk 'NF {printf "%s\\n", $0}'
# The mock sends webhooks to MOCK_WEBHOOK_URL, else APP_URL + /api/github/webhook.
MOCK_WEBHOOK_URL=
# Serve the design kit at /dev/kit in a production build.
REVO_ENABLE_DEV_KIT=
