{
  "name": "@revo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/enums.ts",
    "./fixtures": "./prisma/seed/fixtures.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force && tsx --env-file-if-exists=../../.env prisma/seed/index.ts",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@revo/shared": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@revo/review": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
