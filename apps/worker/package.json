{
  "name": "@revo/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.7.8",
    "ioredis": "^5.8.2",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@revo/db": "workspace:*",
    "@revo/github": "workspace:*",
    "@revo/mock-github": "workspace:*",
    "@revo/review": "workspace:*",
    "@revo/shared": "workspace:*",
    "@types/node": "^24.19.2",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
